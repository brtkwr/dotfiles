#!/bin/zsh
# PATH shim so every launcher that finds `claude` on PATH (shell, ccs, iTerm
# launchers) gets the github channel, not just one alias.
real=$HOME/.local/bin/claude

# subcommands, help/version and non-interactive runs: pass straight through
case $1 in
  mcp|plugin|update|install|doctor|config|setup-token|migrate-installer|remote-control|rc|-v|--version|-h|--help|-p|--print) exec $real "$@" ;;
esac
[[ -t 0 && -t 1 ]] || exec $real "$@"
(( ${@[(Ie)-p]} || ${@[(Ie)--print]} )) && exec $real "$@"

exec $real \
  --mcp-config '{"mcpServers":{"github":{"command":"bun","args":["'$HOME'/Code/brtkwr/dotfiles/claude/channels/github/github.ts"]}}}' \
  --dangerously-load-development-channels server:github "$@"
